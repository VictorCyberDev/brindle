{
  "name": "brindle",
  "version": "0.0.0",
  "private": true,
  "description": "Brindle \u2014 the Recovery Plane for AI Agents",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "demo:m1": "tsx --env-file-if-exists=.env.local scripts/demo-m1.mts --reset",
    "demo:reset": "tsx --env-file-if-exists=.env.local scripts/demo-reset.mts",
    "live:zetaris": "tsx --env-file-if-exists=.env.local scripts/live/zetaris.mts",
    "live:nemotron": "tsx --env-file-if-exists=.env.local scripts/live/nemotron.mts",
    "live": "tsx --env-file-if-exists=.env.local scripts/live/all.mts",
    "zetaris:seed-csv": "tsx --env-file-if-exists=.env.local scripts/zetaris-seed-csv.mts",
    "hmem:conformance": "node --import tsx scripts/hmem-conformance/run.mts",
    "hmem:probe": "node --import tsx scripts/hmem-probe.mts",
    "eval:m6": "node --import tsx scripts/eval-m6.mts",
    "story:snapshot": "node --import tsx scripts/story-snapshot.mts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
