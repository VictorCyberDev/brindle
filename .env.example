# Brindle environment template. Copy to .env.local and fill in.
# Never commit real values. Empty values are treated as "not set".

# "local" (default): MOCK mode. Labelled local test doubles; no sponsor is contacted.
# "live": LIVE mode. Real Zetaris + Nemotron; everything below is REQUIRED and
#         startup fails loudly if any of it is missing or unreachable.
BRINDLE_RUNTIME_MODE=local

# PostgreSQL. Required in live mode. In local mode, if blank, an in-process
# PostgreSQL (PGlite) is used for the sandbox business system.
DATABASE_URL=

# Zetaris - governed READ-ONLY truth plane (hackathon: local Docker). Set ALL FOUR or none.
# REST base INCLUDING the version path. Hackathon local setup example: http://localhost:8888/api/v1.0
ZETARIS_REST_URL=
# Zetaris API key (sent as a Bearer token).
ZETARIS_API_KEY=
# Integer organisation id (sent as the X-Org-ID header).
ZETARIS_ORG_ID=
# SQL schema holding supplier_master, supplier_certifications, procurement_policy.
ZETARIS_SCHEMA=

# Meterless Nightshift Runtime - PRIMARY AI runtime. Set ALL THREE or none.
#   Brindle -> Meterless Nightshift -> NVIDIA provider configured inside Nightshift -> Nemotron-backed lane
# Origin of the Nightshift Runtime (endpoints /v1/models and /v1/chat/completions are appended).
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
# Runtime ROUTE/lane id to request. A route is NOT proof of the underlying model.
METERLESS_MODEL=

# Direct NVIDIA - SECONDARY, development/probing only (BRINDLE_RUNTIME_MODE=local). Used only when
# NEMOTRON_PROVIDER=nvidia. REJECTED when BRINDLE_RUNTIME_MODE=live: competition LIVE requires Meterless.
# The model must be Nemotron-family. No Meterless headers are ever sent to NVIDIA.
NEMOTRON_PROVIDER=
NEMOTRON_MODEL_ID=
NVIDIA_API_KEY=
# Optional. Defaults to https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=

# --- Product layer (M6) -----------------------------------------------------
# Required in production. At least 32 random characters (e.g. `openssl rand -base64 48`).
# Development and tests use a clearly-labelled throwaway secret when this is unset.
BETTER_AUTH_SECRET=
# Public origin of the deployment, e.g. https://brindle-recovery.vercel.app
BETTER_AUTH_URL=
# Optional salt for hashing network addresses on beta requests (defaults to BETTER_AUTH_SECRET).
BRINDLE_IP_SALT=
