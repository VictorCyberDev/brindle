# Brindle environment template. Copy to .env.local and fill in.
# Never commit real values. Empty values are treated as "not set".

# "local" (default): sponsors may be unconfigured; adapters fail loudly if called.
# "live": DATABASE_URL and every sponsor variable below are REQUIRED at startup.
BRINDLE_RUNTIME_MODE=local

# PostgreSQL (required in live mode, and for db:migrate)
DATABASE_URL=

# Zetaris — governed, read-only truth plane. Set BOTH or neither.
ZETARIS_BASE_URL=
ZETARIS_API_KEY=

# Meterless — model/runtime integration and recovery memory. Set BOTH or neither.
METERLESS_BASE_URL=
METERLESS_API_KEY=

# NVIDIA Nemotron — reasoning model identifier (served through the Meterless runtime).
NEMOTRON_MODEL_ID=
