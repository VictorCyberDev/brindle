# Brindle environment template. Copy to .env.local and fill in.
# Never commit real values. Empty values are treated as "not set".

# "local" (default): MOCK mode. Labelled local test doubles; no sponsor is contacted.
# "live": LIVE mode. Real Zetaris + Nemotron; everything below is REQUIRED and
#         startup fails loudly if any of it is missing or unreachable.
BRINDLE_RUNTIME_MODE=local

# PostgreSQL. Required in live mode. In local mode, if blank, an in-process
# PostgreSQL (PGlite) is used for the sandbox business system.
DATABASE_URL=

# Zetaris - governed READ-ONLY truth plane. Set ALL FOUR or none.
# Base URL of your Zetaris API tenant (no trailing slash).
ZETARIS_BASE_URL=
# Zetaris API token (sent as a Bearer token).
ZETARIS_API_KEY=
# Integer organisation id (sent as the X-Org-ID header).
ZETARIS_ORG_ID=
# SQL schema/database holding supplier_master, supplier_certifications, procurement_policy.
ZETARIS_SCHEMA=

# Reasoning model path: "nvidia" (direct NVIDIA hosted API) or "meterless" (Meterless Nightshift hotspot).
NEMOTRON_PROVIDER=
# Exact model id you verified with `npm run live:nemotron` (list them first; do not guess).
NEMOTRON_MODEL_ID=

# NEMOTRON_PROVIDER=nvidia
NVIDIA_API_KEY=
# Optional. Defaults to https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=

# NEMOTRON_PROVIDER=meterless : OpenAI-compatible base URL of the hotspot, e.g. http://192.168.1.20:8088/v1
METERLESS_BASE_URL=
METERLESS_API_KEY=
